- widget:
    font: "$md_body_large"
    halign: "left"
    name: "operation"
    position: "0,0"
    size: "$width,43"
    transparent: "1"
- widget:
    font: "$md_body_large"
    halign: "left"
    name: "name"
    position: "0,61"
    size: "$width,43"
    transparent: "1"
- widget:
    name: "slider1"
    position: "0,122"
    size: "$width,25"
    transparent: "1"
- widget:
    font: "$md_body_large"
    halign: "left"
    name: "status"
    position: "0,165"
    size: "$width,43"
    transparent: "1"
- widget:
    font: "$md_body_large"
    halign: "left"
    position: "0,$height-38"
    render: "Label"
    size: "$width,38"
    source: "DiskSpace"
    transparent: "1"
    children:
      - convert:
          type: "COCDiskSpaceInfo"
          text: "SpaceInfo"
