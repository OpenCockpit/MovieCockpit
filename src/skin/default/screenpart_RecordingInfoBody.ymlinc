- widget:
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    render: "Listbox"
    size: "$width,eval($height/$list_item_height*$list_item_height)"
    source: "list"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: $list_item_height
            fonts:
              - "$md_body_large"
            fields:
              - text:
                  position: "5,0"
                  size: "360,45"
                  flags: RT_VALIGN_CENTER
                  value: 0
              - text:
                  position: "420,0"
                  size: "1236,45"
                  flags: RT_VALIGN_CENTER
                  value: 1
