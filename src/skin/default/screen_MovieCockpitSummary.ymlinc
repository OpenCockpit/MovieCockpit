screen:
  name: "MovieCockpitSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
        imagepath: "~/../images"
    - widget:
        font: "$F_medium"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,$screen_height-70"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceName"
              text: "Name"
    - widget:
        font: "$F_bigger"
        halign: "left"
        position: "0,$screen_height-70"
        render: "Label"
        size: "220,70"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "FileSize"
    - widget:
        font: "$F_bigger"
        halign: "right"
        position: "220,$screen_height-70"
        render: "Label"
        size: "$screen_width-4-220,70"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "MovieDuration"
    # while the list loads (Loading.py): the background covers the movie info, the spinner is on top of it
    - widget:
        name: "background"
        position: "0,0"
        size: "$screen_width,$screen_height"
        zPosition: "3"
    - widget:
        alphatest: "blend"
        name: "lcd_pic_loading"
        position: "center,center"
        size: "54,54"
        transparent: "1"
        zPosition: "4"
