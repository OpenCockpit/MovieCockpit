- widget:
    backgroundColorSelected: "blue"
    enableWrapAround: "1"
    position: "0,0"
    render: "Listbox"
    scrollbarBackgroundColor: "backgroundMedium"
    scrollbarBorderColor: "backgroundLight"
    scrollbarMode: "showAlways"
    scrollbarWidth: "5"
    size: "1200,855"
    source: "list"
    transparent: "1"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: 45
            fonts:
              - "Regular;32"
              - "Regular;30"
              - "Regular;28"
            fields:
              - icon:
                  position: "5,5"
                  size: "35,35"
                  flags: BT_SCALE
                  value: 23
              - icon:
                  position: "50,5"
                  size: "55,35"
                  flags: BT_SCALE
                  value: 24
              - text:
                  position: "120,0"
                  size: "e-485,45"
                  font: "Regular;30"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 20
                  color: {call: MultiContentTemplateColor, args: [25]}
                  color_sel: {call: MultiContentTemplateColor, args: [26]}
              - progress:
                  position: "e-350,15"
                  size: "90,14"
                  value: -22
                  borderWidth: 1
                  foreColor: "gray"
                  foreColorSelected: "white"
                  backColor: "backgroundLight"
                  backColorSelected: "backgroundLight"
              - progress:
                  position: "e-350,15"
                  size: "90,14"
                  value: -27
                  borderWidth: 1
                  foreColor: "red"
                  foreColorSelected: "red"
                  backColor: "backgroundLight"
                  backColorSelected: "backgroundLight"
              - progress:
                  position: "e-350,15"
                  size: "90,14"
                  value: -28
                  borderWidth: 1
                  foreColor: "yellow"
                  foreColorSelected: "yellow"
                  backColor: "backgroundLight"
                  backColorSelected: "backgroundLight"
              - text:
                  position: "e-245,0"
                  size: "230,45"
                  font: "Regular;28"
                  flags: RT_HALIGN_RIGHT|RT_VALIGN_CENTER
                  value: 21
                  color: {call: MultiContentTemplateColor, args: [25]}
                  color_sel: {call: MultiContentTemplateColor, args: [26]}
