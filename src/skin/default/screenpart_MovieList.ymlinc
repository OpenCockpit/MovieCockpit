# the list of the recordings and directories: a row an entry, with its icons, its name, its progress and its date and
# length; the row is as wide as the list (e: the width of the item, COCTemplatedMultiContentEx sets it when the list is drawn)
- widget:
    render: "Listbox"
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    scrollbarMode: "showNever"
    size: "1200,16*52"
    source: "list"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: 52
            fonts: ["$md_body_large", "$md_body_small"]
            fields:
              - icon:
                  flags: "BT_SCALE"
                  value: 23
                  position: "10,8"
                  size: "35,35"
              - icon:
                  flags: "BT_SCALE"
                  value: 24
                  position: "55,8"
                  size: "55,35"
              - text:
                  font: "$md_body_large"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 20
                  color:
                    call: "MultiContentTemplateColor"
                    args: [25]
                  color_sel:
                    call: "MultiContentTemplateColor"
                    args: [26]
                  position: "125,0"
                  size: "(e-10-10)-45-70-110-185-15,52"
              - progress:
                  value: -22
                  borderWidth: 1
                  foreColor: "md_on_surface_variant"
                  foreColorSelected: "md_inverse_on_surface"
                  backColor: "md_surface_container_high"
                  backColorSelected: "md_outline"
                  position: "10+45+70+(e-10-10)-45-70-110-185,19"
                  size: "90,14"
              - progress:
                  value: -27
                  borderWidth: 1
                  foreColor: "md_error"
                  foreColorSelected: "md_inverse_error"
                  backColor: "md_surface_container_high"
                  backColorSelected: "md_outline"
                  position: "10+45+70+(e-10-10)-45-70-110-185,19"
                  size: "90,14"
              - progress:
                  value: -28
                  borderWidth: 1
                  foreColor: "md_key_yellow"
                  foreColorSelected: "md_inverse_warning"
                  backColor: "md_surface_container_high"
                  backColorSelected: "md_outline"
                  position: "10+45+70+(e-10-10)-45-70-110-185,19"
                  size: "90,14"
              - text:
                  font: "$md_body_small"
                  flags: "RT_HALIGN_CENTER|RT_VALIGN_CENTER"
                  value: 21
                  color:
                    call: "MultiContentTemplateColor"
                    args: [25]
                  color_sel:
                    call: "MultiContentTemplateColor"
                    args: [26]
                  position: "10+45+70+(e-10-10)-45-70-110-185+110,0"
                  size: "185,52"
