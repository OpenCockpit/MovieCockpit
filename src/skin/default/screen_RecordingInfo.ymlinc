screen:
  name: "RecordingInfo"
  position: "center,center"
  size: "1416,858"
  transparent: "0"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        enableWrapAround: "1"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "20,70"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1376,720"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "COCTemplatedMultiContentEx"
              cell:
                itemHeight: 45
                fonts:
                  - "$md_body_large"
                fields:
                  - text:
                      position: "5,0"
                      size: "360,45"
                      flags: RT_VALIGN_CENTER
                      value: 0
                  - text:
                      position: "420,0"
                      size: "930,45"
                      flags: RT_VALIGN_CENTER
                      value: 1
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
