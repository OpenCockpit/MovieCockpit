screen:
  name: "MovieInfoEPG"
  position: "center,center"
  size: "1416,858"
  transparent: "0"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        font: "$md_title_large"
        position: "25,60"
        render: "Label"
        size: "250,45"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "ServiceTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "ShortDate"
    - widget:
        font: "$md_title_large"
        halign: "right"
        position: "593,60"
        render: "Label"
        size: "100,45"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "ServiceTime"
              text: "StartTime"
          - convert:
              type: "ClockToText"
              text: "Default"
    - widget:
        font: "$md_title_large"
        halign: "center"
        position: "693,60"
        render: "FixedLabel"
        size: "30,45"
        source: "Service"
        text: "-"
        transparent: "1"
        valign: "center"
    - widget:
        font: "$md_title_large"
        position: "723,60"
        render: "Label"
        size: "110,45"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "ServiceTime"
              text: "EndTime"
          - convert:
              type: "ClockToText"
              text: "Default"
    - widget:
        font: "$md_title_large"
        halign: "right"
        position: "1141,60"
        render: "Label"
        size: "250,45"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "ServiceTime"
              text: "Duration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
    - widget:
        font: "$md_title_large"
        position: "25,115"
        render: "Label"
        size: "1366,45"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCEventName"
              text: "Description"
    - widget:
        font: "$md_body_large"
        foregroundColor: "md_on_surface_variant"
        options: "movetype=swimming, direction=top, startpoint=0, startdelay=4000, wrap=1, always=0, repeat=1, oneshot=1, steptime=100"
        position: "25,135"
        render: "COCRunningText"
        size: "1366,640"
        size2: "1366,580"
        source: "Service"
        transparent: "1"
        children:
          - convert:
              type: "COCEventName"
              text: "ShortAndExtendedDescription"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
