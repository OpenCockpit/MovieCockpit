screen:
  backgroundColor: "md_transparent"
  name: "FileManagerProgress"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "360,325"
        dialog_height: "430"
        dialog_width: "1200"
        size: "$dialog_width,$dialog_height"
        window_inset_x: "$window_dialog_body_x"
    - xmlinc:
        file: "screenpart_FileManagerProgressBody.ymlinc"
        position: "$window_dialog_body_x,$window_dialog_body_y"
        size: "$dialog_width-$window_dialog_trim_x,$dialog_height-$window_dialog_trim_y"
