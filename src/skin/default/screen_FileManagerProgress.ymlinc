screen:
  backgroundColor: "md_transparent"
  name: "FileManagerProgress"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Dialog.ymlinc"
        position: "360,325"
        dialog_height: "430"
        dialog_width: "1200"
    - widget:
        font: "$md_body_large"
        halign: "left"
        name: "operation"
        position: "20,75"
        size: "1160,43"
        transparent: "1"
    - widget:
        font: "$md_body_large"
        halign: "left"
        name: "name"
        position: "20,136"
        size: "1160,43"
        transparent: "1"
    - widget:
        name: "slider1"
        position: "20,197"
        size: "1160,25"
        transparent: "1"
    - widget:
        font: "$md_body_large"
        halign: "left"
        name: "status"
        position: "20,240"
        size: "1160,43"
        transparent: "1"
    - widget:
        font: "$md_body_large"
        halign: "left"
        position: "20,301"
        render: "Label"
        size: "1160,35"
        source: "DiskSpace"
        transparent: "1"
        children:
          - convert:
              type: "COCDiskSpaceInfo"
              text: "SpaceInfo"
