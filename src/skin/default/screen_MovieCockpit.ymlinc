screen:
  name: "MovieCockpit"
  position: "center,center"
  size: "1920,1080"
  transparent: "0"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - ePixmap:
        alphatest: "blend"
        backgroundColor: "black"
        pixmap: "~/../images/sort.svg"
        position: "30,80"
        scale: "scale"
        size: "38,38"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        halign: "left"
        name: "sort_mode"
        position: "80,80"
        size: "510,38"
        transparent: "1"
        valign: "center"
    - ePixmap:
        alphatest: "blend"
        backgroundColor: "black"
        pixmap: "~/../images/hardisk.svg"
        position: "600,80"
        scale: "scale"
        size: "38,38"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        halign: "left"
        position: "650,80"
        render: "Label"
        size: "580,38"
        source: "DiskSpace"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCDiskSpaceInfo"
              text: "SpaceInfo"
    - widget:
        alphatest: "blend"
        name: "pic_loading"
        position: "559,421"
        size: "100,100"
        zPosition: "3"
    - xmlinc:
        file: "screenpart_MovieList.ymlinc"
        position: "30,135"
    - xmlinc:
        file: "screenpart_MovieDetails.ymlinc"
        position: "1260,135"
    - widget:
        font: "$FR_medium"
        foregroundColor: "grey"
        halign: "center"
        name: "level"
        position: "0,1025"
        size: "96,55"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
