screen:
  backgroundColor: "md_transparent"
  name: "MovieCockpit"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - ePixmap:
        alphatest: "blend"
        pixmap: "~/../images/sort.svg"
        position: "30,80"
        scale: "scale"
        size: "38,38"
        transparent: "1"
    - widget:
        font: "$md_label_medium"
        halign: "left"
        name: "sort_mode"
        position: "80,80"
        size: "510,38"
        transparent: "1"
        valign: "center"
    - ePixmap:
        alphatest: "blend"
        pixmap: "~/../images/hardisk.svg"
        position: "600,80"
        scale: "scale"
        size: "38,38"
        transparent: "1"
    - widget:
        font: "$md_label_medium"
        halign: "left"
        position: "650,80"
        render: "Label"
        size: "580,38"
        source: "DiskSpace"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCDiskSpaceInfo"
              text: "SpaceInfo"
    - widget:
        alphatest: "blend"
        name: "pic_loading"
        position: "559,421"
        size: "100,100"
        zPosition: "3"
    - xmlinc:
        file: "screenpart_MovieList.ymlinc"
        position: "30,135"
    - xmlinc:
        file: "screenpart_MovieDetails.ymlinc"
        position: "1260,135"
    - widget:
        font: "$md_headline_small_emphasized"
        foregroundColor: "md_on_surface_variant"
        halign: "center"
        name: "level"
        position: "1636,1020"
        size: "100,36"
        transparent: "1"
        valign: "center"
        zPosition: "20"
