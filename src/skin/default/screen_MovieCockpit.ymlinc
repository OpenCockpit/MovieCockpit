screen:
  backgroundColor: "md_transparent"
  name: "MovieCockpit"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - xmlinc:
        file: "screenpart_MovieCockpitBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
    - widget:
        font: "$md_headline_small_emphasized"
        foregroundColor: "md_on_surface_variant"
        halign: "center"
        name: "level"
        position: "1636,1020"
        size: "100,36"
        transparent: "1"
        valign: "center"
        zPosition: "20"
